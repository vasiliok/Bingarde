# nginx in front of the bingarde app (TurboGears2 on gunicorn).
#
# The official nginx image turns this template into conf.d/default.conf at
# startup, filling in ${NGINX_MAX_BODY_SIZE} from the environment. Other $vars
# (nginx's own, like $http_host) are left alone because they are not set as
# environment variables.

# Open connections per client address (see limit_conn below).
limit_conn_zone $binary_remote_addr zone=perip:10m;
# Download requests per client address. Public builds can be downloaded by
# anyone, so a single address may not start more than this.
limit_req_zone $binary_remote_addr zone=downloads:10m rate=2r/s;

# Errors nginx answers itself (not the app's) get a Bingarde page instead of
# nginx's own: JSON under /api/, HTML elsewhere (nginx/errors, mounted into
# nginx itself, so they work while the app is down).
map $uri $error_format {
    ~^/api/  json;
    default  html;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    error_page 404 /_errors/404.$error_format;
    error_page 413 /_errors/413.$error_format;
    error_page 429 /_errors/429.$error_format;
    error_page 500 502 503 504 /_errors/50x.$error_format;

    # Only file uploads may be large (see the upload location). This matches
    # the app's max_request_body.
    client_max_body_size 2m;
    client_header_timeout 15s;
    client_body_timeout 30s;
    limit_conn perip 64;

    # Use $http_host (keeps the :8080 port) not $host (drops it), so the app
    # builds redirects like http://localhost:8080/builds and the browser can
    # follow them.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # nginx sends "Connection: close" to the app (its default). Keep it: when
    # the app refuses an upload early, gunicorn then closes the connection
    # instead of reading the rest of the body.
    proxy_http_version 1.1;
    # Zip downloads are built by the app: pass them through without spooling
    # them to disk in nginx.
    proxy_max_temp_file_size 0;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # The app adds security headers to its own responses (lib/headers.py);
    # these two locations are answered by nginx, so they get theirs here.
    location /static/ {
        alias /var/www/static/;
        access_log off;
        expires 1h;
        add_header X-Content-Type-Options nosniff always;
    }

    location /_errors/ {
        internal;
        alias /var/www/errors/;
        add_header X-Content-Type-Options nosniff always;
    }

    # Uploaded files. Not reachable from outside ("internal"): the app checks
    # who is asking, then answers with "X-Accel-Redirect: /_store/<path>" and
    # nginx sends the file from the shared volume.
    location /_store/ {
        internal;
        alias /var/www/store/;
        # A download is never shown as a page: no sniffing, and a sandbox
        # without scripts if a browser opens it anyway.
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header X-Frame-Options DENY always;
    }

    # File uploads. Build artifacts can be large (0 would mean "no limit").
    # They stream to the app as they arrive instead of first going to an nginx
    # temp file; the app checks the API token before it reads any of the body.
    location ~ ^/api/v2/builds/[^/]+/files/?$ {
        client_max_body_size ${NGINX_MAX_BODY_SIZE};
        # Give slow CI uploads time; the clock restarts with every chunk.
        client_body_timeout 300s;
        proxy_request_buffering off;
        proxy_pass http://web:8000;
    }

    # Downloads (one file, or a build as zip): the app checks access, then nginx
    # sends the file. At most 2 a second per address, with bursts of 30.
    location ~ ^/(files/|api/v2/builds/[^/]+/archive/?$) {
        limit_req zone=downloads burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://web:8000;
    }

    # Everything else: nginx reads the (small) body first, so a slow client
    # never holds an app thread.
    location / {
        proxy_pass http://web:8000;
    }
}
