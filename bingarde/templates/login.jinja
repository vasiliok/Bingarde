<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Sign in - Bingarde</title>
</head>
<body>
    <h1>Sign in to Bingarde</h1>
    {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}

    {% if google_enabled %}
    <p><a href="/login/google?came_from={{ came_from|urlencode }}">Sign in with Google</a></p>
    {% else %}
    <p>Google sign-in is not configured (set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET).</p>
    {% endif %}

    {% if dev_login %}
    <h2>Developer login</h2>
    <p>DEV_LOGIN is on: sign in with just an e-mail address. Never enable this in production.</p>
    <form method="post" action="/login/dev">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="came_from" value="{{ came_from }}">
        <label>E-mail <input type="email" name="email" required></label>
        <label>Name <input type="text" name="name"></label>
        <button type="submit">Sign in</button>
    </form>
    {% endif %}
</body>
</html>
