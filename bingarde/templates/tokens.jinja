{% extends "bingarde.templates.base" %}

{% block caption %}API tokens - Bingarde{% endblock %}

{% block content %}
<div class="container pb-4" style="max-width: 1100px;">
    <h1 class="h4 mb-1">API tokens</h1>
    <p class="text-body-secondary">Tokens let CI machines use the API: <code>curl -H "Authorization: Bearer bg_..." ...</code>
       {% if is_admin %}As an admin you see everyone's tokens.{% endif %}</p>

    {% if new_token %}
    <div class="alert alert-success new-token" role="status">
        <p class="mb-2"><i class="bi bi-check-circle me-1"></i><strong>Your new token.</strong> Copy it now: it will not be shown again.</p>
        <span class="user-select-all"><code id="new-token">{{ new_token }}</code></span>
    </div>
    {% endif %}
    {% if error %}<div class="alert alert-danger error" role="alert">{{ error }}</div>{% endif %}

    <div class="card page-card mb-4">
        <div class="card-header bg-body fw-semibold"><i class="bi bi-key me-1"></i>Create a token</div>
        <div class="card-body">
            <form class="row g-3 align-items-end" method="post" action="/tokens/create">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                <div class="col-md-5">
                    <label for="id-token-name" class="form-label">Name</label>
                    <input type="text" class="form-control" id="id-token-name" name="name" maxlength="100" required placeholder="e.g. jenkins-ios">
                </div>
                <div class="col-md-5">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="scope" id="id-scope-read" value="read" checked>
                        <label class="form-check-label" for="id-scope-read">read <span class="text-body-secondary">(list and download)</span></label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="scope" id="id-scope-write" value="write"{% if not can_write %} disabled{% endif %}>
                        <label class="form-check-label" for="id-scope-write">write <span class="text-body-secondary">{% if can_write %}(also create builds and upload){% else %}(your account has read-only access){% endif %}</span></label>
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card page-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="id-token-table">
                <thead><tr>
                    <th>Name</th>{% if is_admin %}<th>Owner</th>{% endif %}<th>Token</th><th>Scope</th>
                    <th>Created</th><th>Last used</th><th>Status</th><th></th>
                </tr></thead>
                <tbody>
                {% for t in tokens %}
                <tr>
                    <td>{{ t.name }}</td>{% if is_admin %}<td>{{ t.user.email }}</td>{% endif %}
                    <td><code>{{ t.token_prefix }}…</code></td>
                    <td>{{ t.scope }}{% if t.scope == "write" and not h.can_write(t.user) %} <span class="badge text-bg-warning" title="The owner has read-only access, so this token can only read">read only</span>{% endif %}</td>
                    <td>{{ h.format_date(t.created_at) }}</td>
                    <td>{{ h.format_date(t.last_used_at) or "never" }}</td>
                    <td>{% if t.revoked_at %}<span class="badge text-bg-secondary">revoked</span>{% else %}<span class="badge text-bg-success">active</span>{% endif %}</td>
                    <td class="text-end">{% if not t.revoked_at %}
                        <form method="post" action="/tokens/revoke" class="mb-0">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                            <input type="hidden" name="token_id" value="{{ t.id }}">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Revoke</button>
                        </form>{% endif %}</td>
                </tr>
                {% else %}
                <tr><td colspan="8" class="text-center text-body-secondary py-4">No tokens yet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
